[Unit]
Description=Ishcondidim - Filtro Milter Postfix Autocrypt L1 em Rust
Documentation=https://ishcondidim.2lp.in
After=network.target local-fs.target
Before=postfix.service

[Service]
Type=simple
User=postfix
Group=postfix
ExecStart=/usr/local/bin/ishcondidim --config /etc/ishcondidim/ishcondidim.toml
Restart=always
RestartSec=3s

# Hardening e isolamento estrito
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/ishcondidim /var/lib/ishcondidim
ReadOnlyPaths=/etc/ishcondidim
PrivateTmp=true
NoNewPrivileges=true

RuntimeDirectory=ishcondidim
RuntimeDirectoryMode=0770

StateDirectory=ishcondidim
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
